@model WebApplication1.Models.Event

@{
    ViewData["Title"] = "Manage Attendees";
}

<h1>@ViewData["EventName"]</h1>

<h3>Register Attendee</h3>
<form asp-action="ManageAttendees" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input type="text" name="Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="Email" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-success">Sign Up</button>
</form>

<hr />

<h3>Attendees</h3>
@if (Model.Attendees.Count == 0)
{
    <p>No attendees yet.</p>
}
else
{
    <ul>
        @foreach (var a in Model.Attendees)
        {
            <li>@a.Name (@a.Email)</li>
        }
    </ul>
}